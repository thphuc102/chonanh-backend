generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Album {
  id                String   @id @default(uuid())
  title             String
  customerName      String?
  customerEmail     String?
  customerPhone     String?
  coverImage        String?
  imageCount        Int      @default(0)
  size              String?
  status            String   @default("Mới")
  date              String?
  creator           String?
  creatorId         String?
  creatorEmail      String?
  domain            String?
  driveLink         String?
  downloadDriveLink String?
  finalDriveLink    String?
  tags              String[]
  shootDate         String?
  shootLocation     String?
  password          String?
  expiryDate        DateTime? @db.Date
  landingCover      String?
  landingAvatar     String?
  landingFooter     String?
  selectionStatus   String?  @default("selecting")
  selectionLockedAt DateTime?
  priceLink         String?
  zaloLink          String?
  totalViews        Int      @default(0)
  maxSelections     Int?
  createdAt         String?

  settings          Json?

  photos            Photo[]
  guestbookEntries  GuestbookEntry[]
  rsvps             RSVP[]
}

model Photo {
  id              String   @id @default(uuid())
  albumId         String
  name            String   @default("")
  url             String
  thumbnailLink   String?
  downloadUrl     String?
  isInWeddingView Boolean  @default(false)
  isFavorite      Boolean  @default(false)
  isSuggested     Boolean  @default(false)
  commentCount    Int      @default(0)
  comments        Json     @default("[]")
  tags            String[]
  source          String   @default("drive")
  createdAt       DateTime @default(now())
  likes           String[] @default([])
  likeCount       Int      @default(0)

  album           Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@index([albumId])
}

model Setting {
  id    String @id @default("global")
  data  Json
}

model AuditLog {
  id        String @id @default(uuid())
  userId    String
  userName  String
  action    String
  details   String
  timestamp DateTime @default(now())
  ipAddress String?
  status    String @default("Success")
}

model Notification {
  id        String  @id @default(uuid())
  type      String
  title     String
  message   String
  albumId   String?
  userId    String?
  read      Boolean @default(false)
  createdAt DateTime @default(now())
}

model ContactRequest {
  id            String  @id @default(uuid())
  userId        String
  userName      String
  email         String
  phone         String
  requestType   String
  message       String?
  notes         String?
  planRequested String?
  billingCycle  String?
  albumId       String?
  albumName     String?
  status        String  @default("pending")
  createdAt     DateTime?
  contactedAt   DateTime?
  completedAt   DateTime?
  respondedAt   DateTime?
  respondedBy   String?
  adminNotes    String?
}

model Workspace {
  id        String @id @default(uuid())
  userId    String
  name      String
  color     String
  createdAt String

  @@index([userId])
}

model GuestbookEntry {
  id         String   @id
  albumId    String
  senderName String
  message    String
  stickerUrl String?
  createdAt  DateTime @default(now())
  isPrivate  Boolean  @default(false)

  album      Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@index([albumId, createdAt(sort: Desc)])
}

model User {
  id                 String    @id
  name               String
  email              String    @unique
  role               String    @default("User")
  status             String    @default("Active")
  avatar             String    @default("")
  lastActive         String?
  phone              String?
  plan               String    @default("free")
  subscriptionStatus String    @default("active")
  subscriptionStart  String?
  subscriptionEnd    String?
  subscriptionNotes  String?
  albumsUsed         Int       @default(0)
  albumsLimit        Int       @default(2)
  storageUsedMB      Int       @default(0)
  storageLimitMB     Int       @default(500)
  weddingAddOns      String[]  @default([])
  createdAt          String?
}

model RSVP {
  id          String   @id @default(uuid())
  albumId     String
  name        String
  phone       String
  attending   Boolean
  guestsCount Int      @default(0)
  note        String?
  createdAt   DateTime @default(now())

  album       Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@index([albumId])
}
